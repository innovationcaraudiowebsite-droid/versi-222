# ============================================================
# Environment Variables — Peredam Mobil Jakarta
# ============================================================
# App supports 2 modes:
#
# Mode 1: MOCK DATA (default, no setup needed)
#   Reads from data/backup-sqlite.json
#   Read-only: ✅ view articles/products/landing
#              ❌ admin write (create/edit/delete)
#
# Mode 2: SUPABASE (real database, full features)
#   Add these vars:
#
#   SUPABASE_URL=https://your-project.supabase.co
#   SUPABASE_SECRET_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6...
#   NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
#   NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6...
#   ADMIN_USERNAME=admin
#   ADMIN_PASSWORD_HASH=$2a$10$... (bcrypt)
#
# Admin login uses ADMIN_USERNAME + ADMIN_PASSWORD_HASH.
# Hash generated with: bun run src/scripts/hash-password.ts <password>
# ============================================================

# Legacy Prisma DATABASE_URL — not used (mock data mode)
DATABASE_URL=file:/home/z/my-project/db/custom.db
